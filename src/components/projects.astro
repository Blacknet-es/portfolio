---
import ProjectCard from './project-card.astro';
import { useTranslations } from '../i18n/utils';
import { getPortfolioData } from '../utils/data';
import type { Lang } from '../i18n/ui';

interface Project {
  title: string;
  description: string;
  images: string[];
  tech: string[];
  platforms: string[];
  link: string;
  category: string;
}

interface Props {
  lang?: Lang;
  data?: Project[];
}

const { lang = 'es', data: propData } = Astro.props;
const t = useTranslations(lang);

const isApiLive = import.meta.env.PROD;
const BASE_URL = import.meta.env.PUBLIC_API_BASE_URL;

let projects: Project[];

if (propData) {
  projects = propData;
} else if (isApiLive && BASE_URL) {
  try {
    const response = await fetch(`${BASE_URL}/projects?lang=${lang}`);
    if (!response.ok) throw new Error('Network response was not ok');
    projects = await response.json();
  } catch (error) {
    console.error("API Fetch failed, falling back to mock data", error);
    projects = getPortfolioData(lang).projects as Project[];
  }
} else {
  projects = getPortfolioData(lang).projects as Project[];
}
---

<section id="projects" class="section-container">
  <div class="container mx-auto">
    <div class="project-header opacity-0 mb-12">
      <h2 class="text-3xl md:text-4xl font-heading font-bold text-maintext mb-2 flex items-center gap-4">
        <span class="text-accent">/</span> {t('projects.title')}
      </h2>
      <p class="text-subtext font-body text-sm max-w-md">
        {t('projects.subtitle')}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        projects.map((project) => (
          <ProjectCard project={project} lang={lang} />
        ))
      }
    </div>
  </div>
</section>

<style>
  .project-header {
    transform: translateY(20px);
    transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .project-header.reveal {
    opacity: 1 !important;
    transform: translateY(0);
  }
</style>

<script>
  const initProjectReveal = () => {
    const header = document.querySelector('.project-header');
    const cards = document.querySelectorAll('.project-card');

    const cardIndexMap = new Map<Element, number>();
    cards.forEach((card, i) => cardIndexMap.set(card, i));

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const target = entry.target as HTMLElement;

          if (target.classList.contains('project-header')) {
            target.classList.add('reveal');
            observer.unobserve(target);
          } 
          else if (target.classList.contains('project-card')) {
            const index = cardIndexMap.get(target) ?? 0;
            setTimeout(() => {
              target.classList.add('reveal');
            }, (index % 3) * 150);
            observer.unobserve(target);
          }
        }
      });
    }, { 
      threshold: 0.15, 
      rootMargin: '0px 0px -10px 0px' 
    });

    if (header) observer.observe(header);
    cards.forEach(card => observer.observe(card));
  };

  window.addEventListener('load', initProjectReveal);
  document.addEventListener('astro:after-swap', initProjectReveal);
</script>
