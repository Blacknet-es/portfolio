---
import { Icon } from 'astro-icon/components';
import CareerCard from './career-card.astro';
import { useTranslations } from '../i18n/utils';
import { getPortfolioData } from '../utils/data';
import type { Lang } from '../i18n/ui';

interface CareerItem {
  company: string;
  role: string;
  period: string;
  type: string;
  description: string;
  skills: string[];
  url?: string;
}

interface Props {
  lang?: Lang;
  data?: CareerItem[];
}

const { lang = 'es', data: propData } = Astro.props;
const t = useTranslations(lang);

const isApiLive = import.meta.env.PROD;
const BASE_URL = import.meta.env.PUBLIC_API_BASE_URL;

let careerData: CareerItem[];

if (propData) {
  careerData = propData;
} else if (isApiLive && BASE_URL) {
  try {
    const response = await fetch(`${BASE_URL}/career?lang=${lang}`);
    if (!response.ok) throw new Error('Network response was not ok');
    careerData = await response.json();
  } catch (error) {
    console.error("API Fetch failed, falling back to mock data", error);
    careerData = getPortfolioData(lang).career as CareerItem[];
  }
} else {
  careerData = getPortfolioData(lang).career as CareerItem[];
}

const getItemMeta = (type: string) => {
  if (type === 'Student') return { icon: 'mdi:school', category: 'education' };
  if (type === 'Internship') return { icon: 'mdi:briefcase-outline', category: 'work' };
  return { icon: 'mdi:briefcase', category: 'work' };
};
---

<section id="career" class="section-container max-w-6xl mx-auto overflow-hidden">
  <div class="container mx-auto reveal-content" style="animation-delay: 1000ms;">

    <!-- Section header + filter tabs -->
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 pb-8">
      <div>
        <h2 class="text-3xl md:text-4xl font-heading font-bold text-maintext mb-2 flex items-center gap-4">
          <span class="text-accent">/</span> {t('career.title')}
        </h2>
        <p class="text-subtext font-body text-sm max-w-md">
          {t('career.subtitle')}
        </p>
      </div>

      <!-- Filter chips -->
      <div class="flex gap-2 flex-wrap shrink-0">
        <button class="career-filter-btn active" data-filter="all">{t('career.filter.all')}</button>
        <button class="career-filter-btn" data-filter="work">
          <Icon name="mdi:briefcase" class="w-3.5 h-3.5 inline" />
          {t('career.filter.work')}
        </button>
        <button class="career-filter-btn" data-filter="education">
          <Icon name="mdi:school" class="w-3.5 h-3.5 inline" />
          {t('career.filter.education')}
        </button>
      </div>
    </div>

    <!-- Timeline Wrapper -->
    <div class="relative py-8">

      <!-- MOBILE TIMELINE: Left border only -->
      <div class="md:hidden relative border-l border-accent/20 pl-6 space-y-12">
        {careerData.map((item) => {
          const { icon, category } = getItemMeta(item.type);
          return (
            <div class="scroll-stat relative" data-category={category}>
              <div class="absolute -left-[31px] top-1.5 w-3.5 h-3.5 rounded-full bg-accent border-2 border-background animate-outer-glow flex items-center justify-center">
                <Icon name={icon} class="w-2 h-2 text-background" />
              </div>
              <CareerCard item={item} variant="mobile" lang={lang} />
            </div>
          );
        })}
      </div>

      <!-- DESKTOP TIMELINE: Center spine -->
      <div class="hidden md:block relative">
        <div class="absolute left-1/2 -translate-x-1/2 top-0 bottom-0 w-px bg-accent/20"></div>

        <div class="space-y-12">
          {careerData.map((item, index) => {
            const isLeft = index % 2 === 0;
            const { icon, category } = getItemMeta(item.type);

            return (
              <div class="scroll-stat grid grid-cols-[1fr_auto_1fr] items-center gap-6" data-category={category}>
                {isLeft ? (
                  <CareerCard item={item} variant="desktop-left" lang={lang} />
                ) : (
                  <div></div>
                )}

                <div class="relative flex items-center justify-center z-10">
                  <div class="w-8 h-8 rounded-full bg-background border-2 border-accent flex items-center justify-center shadow-[0_0_15px_color-mix(in_srgb,var(--color-accent)_40%,transparent)] group-hover:scale-110 transition-transform">
                    <Icon name={icon} class="w-4 h-4 text-accent" />
                  </div>
                </div>

                {!isLeft ? (
                  <CareerCard item={item} variant="desktop-right" lang={lang} />
                ) : (
                  <div></div>
                )}
              </div>
            );
          })}
        </div>
      </div>

      <!-- See More overlay button -->
      <div id="see-more-overlay" class="see-more-gradient hidden flex-col items-center justify-end pb-4 pt-16 mt-4">
        <button
          id="see-more-btn"
          class="inline-flex items-center gap-2 px-6 py-2.5 rounded-full border border-accent/40 bg-background/90 text-accent font-body text-xs font-bold tracking-wider uppercase backdrop-blur-sm hover:border-accent hover:bg-accent/10 hover:shadow-[0_0_20px_color-mix(in_srgb,var(--color-accent)_25%,transparent)] transition-all duration-300 cursor-pointer"
        >
          <span>{t('career.seeMore')}</span>
          <Icon name="mdi:chevron-down" class="w-4 h-4" />
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .reveal-content {
    opacity: 0;
    transform: translateY(20px);
    animation: revealIn 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
  }

  @keyframes revealIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes outer-glow {
    0%, 100% {
      box-shadow: 0 0 10px var(--color-accent);
    }
    50% {
      box-shadow: 0 0 25px var(--color-accent), 0 0 15px var(--color-accent);
    }
  }

  .animate-outer-glow {
    animation: outer-glow 2.5s ease-in-out infinite;
  }

  .scroll-stat {
    opacity: 0;
    transform: translateY(20px) scale(0.95);
    transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .scroll-stat.reveal {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .scroll-stat.filtered-out,
  .scroll-stat.hidden-by-limit {
    display: none !important;
  }

  .scroll-stat.blurred-out {
    opacity: 0.5 !important;
    filter: blur(2px);
    pointer-events: none;
    user-select: none;
  }

  .career-filter-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--font-body);
    font-size: 0.625rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    padding: 0.3rem 0.8rem;
    border-radius: 9999px;
    border: 1px solid color-mix(in srgb, var(--color-accent) 30%, transparent);
    color: color-mix(in srgb, var(--color-accent) 65%, transparent);
    background: transparent;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .career-filter-btn:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
  }

  .career-filter-btn.active {
    background: color-mix(in srgb, var(--color-accent) 15%, transparent);
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
</style>

<script>
  function revealCards() {
    const cards = document.querySelectorAll('.scroll-stat');
    const cardIndexMap = new Map<Element, number>();
    cards.forEach((card, i) => cardIndexMap.set(card, i));

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const index = cardIndexMap.get(entry.target) ?? 0;
          setTimeout(() => {
            entry.target.classList.add('reveal');
          }, (index % 2) * 150);
          observer.unobserve(entry.target);
        }
      });
    }, {
      threshold: 0.15,
      rootMargin: '0px 0px -10px 0px'
    });

    cards.forEach(card => observer.observe(card));
  }

  function initListLogic() {
    const filterBtns = document.querySelectorAll('.career-filter-btn[data-filter]');
    const seeMoreBtn = document.getElementById('see-more-btn');
    const overlay = document.getElementById('see-more-overlay');
    const careerItemsMobile = document.querySelectorAll('.md\\:hidden .scroll-stat');
    const careerItemsDesktop = document.querySelectorAll('.hidden.md\\:block .scroll-stat');
    
    const LIMIT = 3;
    let currentFilter = 'all';
    let isExpanded = false;

    function updateView() {
      let totalMatching = 0;

      [careerItemsMobile, careerItemsDesktop].forEach(list => {
        let visibleCount = 0;
        list.forEach(item => {
          const category = (item as HTMLElement).dataset.category ?? '';
          const matchesFilter = (currentFilter === 'all' || category === currentFilter);
          
          item.classList.remove('filtered-out', 'hidden-by-limit', 'blurred-out');
          
          if (!matchesFilter) {
            item.classList.add('filtered-out');
          } else {
            visibleCount++;
            if (!isExpanded) {
              if (visibleCount <= LIMIT) {
                // normal
              } else if (visibleCount === LIMIT + 1) {
                item.classList.add('blurred-out');
              } else {
                item.classList.add('hidden-by-limit');
              }
            }
          }
        });
        if (list === careerItemsMobile) totalMatching = visibleCount; 
      });

      filterBtns.forEach(btn => {
        if ((btn as HTMLElement).dataset.filter === currentFilter) {
          btn.classList.add('active');
        } else {
          btn.classList.remove('active');
        }
      });

      if (overlay) {
        if (totalMatching > LIMIT && !isExpanded) {
          overlay.style.display = 'flex';
        } else {
          overlay.style.display = 'none';
        }
      }
      
      revealCards();
    }

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        currentFilter = (btn as HTMLElement).dataset.filter ?? 'all';
        isExpanded = false;
        updateView();
      });
    });

    if (seeMoreBtn) {
      seeMoreBtn.addEventListener('click', () => {
        isExpanded = true;
        updateView();
      });
    }

    updateView();
  }

  revealCards();
  initListLogic();

  document.addEventListener('astro:after-swap', () => {
    revealCards();
    initListLogic();
  });
</script>
